{
  "module": "origenerator",
  "window_title": "Origenerator",
  "check_launch_flag": "--check-launch",
  "spoken_phrases_module": "origenerator.voice.hosted",
  "required_flags": [
    "--fun-time",
    "--x",
    "--y",
    "--width",
    "--height",
    "--taskbar-identity",
    "--command-file",
    "--paused-file",
    "--status-file",
    "--dashboard-cmd-file"
  ],
  "region_flags": {
    "portrait": [
      "--portrait-x",
      "--portrait-y",
      "--portrait-width",
      "--portrait-height"
    ],
    "landscape": [
      "--landscape-x",
      "--landscape-y",
      "--landscape-width",
      "--landscape-height"
    ]
  },
  "player_flags": {
    "portrait": [
      "--portrait-playlist",
      "--portrait-cmd-file",
      "--portrait-status-file",
      "--portrait-hud-file"
    ],
    "landscape": [
      "--landscape-playlist",
      "--landscape-cmd-file",
      "--landscape-status-file",
      "--landscape-hud-file"
    ]
  },
  "headset_flags": [
    "--frames-file",
    "--input-file"
  ],
  "headset_words": [
    "press",
    "release",
    "drag",
    "hover",
    "scroll",
    "rightclick"
  ],
  "command_case_blind": true,
  "command_lines": [
    "CLOSE_SLIDESHOWS",
    "FILTER_ENHANCED",
    "RELEASE",
    "TAKE_BACK",
    "HAND_OVER|{frames}|{input}",
    "GO_TO|{file}",
    "portrait_open_slideshow",
    "portrait_close_slideshow",
    "portrait_prev",
    "portrait_next",
    "portrait_lock",
    "portrait_lock_on",
    "portrait_lock_off",
    "portrait_trash",
    "portrait_reset",
    "portrait_shuffle",
    "portrait_latest",
    "portrait_fmode",
    "portrait_fmode_on",
    "portrait_fmode_off",
    "portrait_enhanced",
    "portrait_seed_loop",
    "portrait_action_loop",
    "portrait_no_loop",
    "portrait_loop",
    "portrait_more_seeds",
    "portrait_no_filter",
    "portrait_lock_action",
    "portrait_nav_left",
    "portrait_nav_right",
    "portrait_nav_up",
    "portrait_nav_down",
    "portrait_cycle_seed",
    "portrait_cycle_action",
    "portrait_cycle_version",
    "portrait_cycle_version_back",
    "portrait_play_video|{file}",
    "portrait_lock_video|{file}",
    "portrait_hud_corner|{corner}",
    "portrait_hud_minimized|{on}",
    "filter_portrait_{row}",
    "portrait_say:{words}",
    "landscape_open_slideshow",
    "landscape_close_slideshow",
    "landscape_prev",
    "landscape_next",
    "landscape_lock",
    "landscape_lock_on",
    "landscape_lock_off",
    "landscape_trash",
    "landscape_reset",
    "landscape_shuffle",
    "landscape_latest",
    "landscape_fmode",
    "landscape_fmode_on",
    "landscape_fmode_off",
    "landscape_enhanced",
    "landscape_seed_loop",
    "landscape_action_loop",
    "landscape_no_loop",
    "landscape_loop",
    "landscape_more_seeds",
    "landscape_no_filter",
    "landscape_lock_action",
    "landscape_nav_left",
    "landscape_nav_right",
    "landscape_nav_up",
    "landscape_nav_down",
    "landscape_cycle_seed",
    "landscape_cycle_action",
    "landscape_cycle_version",
    "landscape_cycle_version_back",
    "landscape_play_video|{file}",
    "landscape_lock_video|{file}",
    "landscape_hud_corner|{corner}",
    "landscape_hud_minimized|{on}",
    "filter_landscape_{row}",
    "landscape_say:{words}"
  ],
  "command_patterns": [
    "(?i)CLOSE_SLIDESHOWS",
    "(?i)FILTER_ENHANCED",
    "(?i)RELEASE",
    "(?i)TAKE_BACK",
    "(?i)HAND_OVER\\|.+\\|.+",
    "(?i)GO_TO\\|.+",
    "(?i)portrait_open_slideshow",
    "(?i)portrait_close_slideshow",
    "(?i)portrait_prev",
    "(?i)portrait_next",
    "(?i)portrait_lock",
    "(?i)portrait_lock_on",
    "(?i)portrait_lock_off",
    "(?i)portrait_trash",
    "(?i)portrait_reset",
    "(?i)portrait_shuffle",
    "(?i)portrait_latest",
    "(?i)portrait_fmode",
    "(?i)portrait_fmode_on",
    "(?i)portrait_fmode_off",
    "(?i)portrait_enhanced",
    "(?i)portrait_seed_loop",
    "(?i)portrait_action_loop",
    "(?i)portrait_no_loop",
    "(?i)portrait_loop",
    "(?i)portrait_more_seeds",
    "(?i)portrait_no_filter",
    "(?i)portrait_lock_action",
    "(?i)portrait_nav_left",
    "(?i)portrait_nav_right",
    "(?i)portrait_nav_up",
    "(?i)portrait_nav_down",
    "(?i)portrait_cycle_seed",
    "(?i)portrait_cycle_action",
    "(?i)portrait_cycle_version",
    "(?i)portrait_cycle_version_back",
    "(?i)portrait_play_video\\|.+",
    "(?i)portrait_lock_video\\|.+",
    "(?i)portrait_hud_corner\\|.+",
    "(?i)portrait_hud_minimized\\|.+",
    "(?i)filter_portrait_.+",
    "(?i)portrait_say:.+",
    "(?i)landscape_open_slideshow",
    "(?i)landscape_close_slideshow",
    "(?i)landscape_prev",
    "(?i)landscape_next",
    "(?i)landscape_lock",
    "(?i)landscape_lock_on",
    "(?i)landscape_lock_off",
    "(?i)landscape_trash",
    "(?i)landscape_reset",
    "(?i)landscape_shuffle",
    "(?i)landscape_latest",
    "(?i)landscape_fmode",
    "(?i)landscape_fmode_on",
    "(?i)landscape_fmode_off",
    "(?i)landscape_enhanced",
    "(?i)landscape_seed_loop",
    "(?i)landscape_action_loop",
    "(?i)landscape_no_loop",
    "(?i)landscape_loop",
    "(?i)landscape_more_seeds",
    "(?i)landscape_no_filter",
    "(?i)landscape_lock_action",
    "(?i)landscape_nav_left",
    "(?i)landscape_nav_right",
    "(?i)landscape_nav_up",
    "(?i)landscape_nav_down",
    "(?i)landscape_cycle_seed",
    "(?i)landscape_cycle_action",
    "(?i)landscape_cycle_version",
    "(?i)landscape_cycle_version_back",
    "(?i)landscape_play_video\\|.+",
    "(?i)landscape_lock_video\\|.+",
    "(?i)landscape_hud_corner\\|.+",
    "(?i)landscape_hud_minimized\\|.+",
    "(?i)filter_landscape_.+",
    "(?i)landscape_say:.+"
  ],
  "request_lines": [
    "portrait_request_open",
    "portrait_request_closed",
    "landscape_request_open",
    "landscape_request_closed"
  ],
  "handoff": {
    "offer": {
      "file": "fun_time_offer.txt",
      "writes": [
        "4242 4343",
        "4242 4343 starting"
      ]
    },
    "showing": {
      "file": "fun_time_showing.txt",
      "writes": [
        "4242 4343"
      ]
    },
    "session": {
      "file": "fun_time_session.txt",
      "reads": {
        "pattern": "(\\d+) (\\d+)"
      }
    },
    "takeover": {
      "file": "fun_time_takeover.json",
      "reads": {
        "keys": [
          "args",
          "pid"
        ]
      }
    }
  }
}
