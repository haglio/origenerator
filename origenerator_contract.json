{
  "module": "origenerator",
  "window_title": "Origenerator",
  "show_titles": {
    "portrait": "Origenerator Portrait",
    "landscape": "Origenerator Landscape"
  },
  "check_launch_flag": "--check-launch",
  "required_flags": [
    "--fun-time",
    "--x",
    "--y",
    "--width",
    "--height",
    "--taskbar-identity",
    "--command-file",
    "--paused-file",
    "--status-file",
    "--dashboard-cmd-file"
  ],
  "region_flags": {
    "portrait": [
      "--portrait-x",
      "--portrait-y",
      "--portrait-width",
      "--portrait-height"
    ],
    "landscape": [
      "--landscape-x",
      "--landscape-y",
      "--landscape-width",
      "--landscape-height"
    ]
  },
  "player_flags": {
    "portrait": [
      "--portrait-playlist",
      "--portrait-cmd-file",
      "--portrait-status-file",
      "--portrait-hud-file"
    ],
    "landscape": [
      "--landscape-playlist",
      "--landscape-cmd-file",
      "--landscape-status-file",
      "--landscape-hud-file"
    ]
  },
  "headset_flags": [
    "--frames-file",
    "--input-file"
  ],
  "headset_words": [
    "press",
    "release",
    "drag",
    "hover",
    "scroll"
  ],
  "command_case_blind": true,
  "command_lines": [
    "OPEN_SHOWS",
    "CLOSE_SHOWS",
    "FILTER_ENHANCED",
    "RELEASE",
    "GO_TO|{file}",
    "portrait_prev",
    "portrait_next",
    "portrait_lock",
    "portrait_trash",
    "portrait_reset",
    "portrait_shuffle",
    "portrait_latest",
    "portrait_fmode",
    "portrait_enhanced",
    "portrait_seed_loop",
    "portrait_action_loop",
    "portrait_no_loop",
    "portrait_loop",
    "portrait_more_seeds",
    "portrait_no_filter",
    "portrait_nav_left",
    "portrait_nav_right",
    "portrait_nav_up",
    "portrait_nav_down",
    "portrait_cycle_seed",
    "portrait_cycle_action",
    "portrait_cycle_version",
    "portrait_cycle_version_back",
    "portrait_play_video|{file}",
    "portrait_lock_video|{file}",
    "filter_portrait_{row}",
    "portrait_say:{words}",
    "landscape_prev",
    "landscape_next",
    "landscape_lock",
    "landscape_trash",
    "landscape_reset",
    "landscape_shuffle",
    "landscape_latest",
    "landscape_fmode",
    "landscape_enhanced",
    "landscape_seed_loop",
    "landscape_action_loop",
    "landscape_no_loop",
    "landscape_loop",
    "landscape_more_seeds",
    "landscape_no_filter",
    "landscape_nav_left",
    "landscape_nav_right",
    "landscape_nav_up",
    "landscape_nav_down",
    "landscape_cycle_seed",
    "landscape_cycle_action",
    "landscape_cycle_version",
    "landscape_cycle_version_back",
    "landscape_play_video|{file}",
    "landscape_lock_video|{file}",
    "filter_landscape_{row}",
    "landscape_say:{words}"
  ]
}
