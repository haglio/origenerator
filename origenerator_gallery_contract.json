{
  "database_path": "state/origenerator.db",
  "table": "generations",
  "columns": [
    "prompt_id",
    "source",
    "workflow_name",
    "workflow_version",
    "positive_prompt",
    "negative_prompt",
    "seed",
    "params_json",
    "output_files",
    "created_at"
  ],
  "optional_columns": [
    "provenance",
    "evolver_exported_at",
    "evolver_unsent_at",
    "genau_exported_at",
    "genau_unsent_at",
    "remade_at",
    "starred",
    "evolver_upscale",
    "web_url",
    "library_id",
    "upscale_provenance",
    "watch_completions",
    "watch_skips",
    "watch_locks",
    "recipe_category",
    "combined_labels",
    "shape",
    "video_seconds",
    "genau_flipped",
    "video_resolution",
    "video_aspect_ratio"
  ],
  "params_model_keys": [
    "unet_high",
    "unet",
    "checkpoint",
    "unet_low"
  ],
  "params_input_image_key": "input_image",
  "lanes": {
    "evolver": {
      "sent": "evolver_exported_at",
      "unsent": "evolver_unsent_at"
    },
    "genau": {
      "sent": "genau_exported_at",
      "unsent": "genau_unsent_at"
    }
  },
  "silent_copy_role": "silent",
  "generated_fps": 16.0,
  "downtime_command": [
    ".venv/Scripts/python.exe",
    "-m",
    "origenerator.downtime"
  ],
  "outside_video_entries_command": [
    ".venv/Scripts/python.exe",
    "-m",
    "origenerator.outside_video_entries"
  ],
  "records_command": [
    ".venv/Scripts/python.exe",
    "-m",
    "origenerator.ai_video_records"
  ],
  "outside_workflow_prefixes": {
    "video": "outside:",
    "image_to_video": "outside image-to-video:",
    "text_to_video": "outside text-to-video:",
    "image": "outside picture:"
  }
}
